# =============================================================================
#  .env.example — Copia este archivo a .env y rellena las credenciales.
#  .env está gitignored: NUNCA se commitea. Este archivo solo lleva marcadores
#  REEMPLAZA_*, jamás valores reales.
#  Para deploy, estas variables también van en la plataforma de hosting (runtime).
# =============================================================================

# --- Base de Datos PostgreSQL ---
DATABASE_URL=postgres://user:pass@localhost:5432/saas_toi

# --- Cifrado de Secretos en Reposo (AES-256-GCM) ---
# Clave de 32 bytes en hex. Generar con: openssl rand -hex 32
# NO la rotes a la ligera si ya cifró tokens de Meta o credenciales MikroTik:
# los datos existentes quedarían indescifrables.
ENCRYPTION_KEY=REEMPLAZA_32_bytes_hex

# --- Sesiones de Usuario (spec 011) ---
# Secreto HMAC que firma la cookie de sesión. 32 bytes en hex.
# Generar con: openssl rand -hex 32
# Rotarlo invalida todas las sesiones activas (todos vuelven a iniciar sesión),
# pero NO destruye datos. Es seguro rotarlo ante sospecha de compromiso.
SESSION_SECRET=REEMPLAZA_32_bytes_hex

# --- Meta WhatsApp Cloud API ---
# App ID público (developers.facebook.com → Tu app → Configuración → Básica)
# Usado por el SDK del navegador para Embedded Signup.
NEXT_PUBLIC_META_APP_ID=REEMPLAZA_APP_ID
# App ID legacy (mismo valor que NEXT_PUBLIC_META_APP_ID, para servicios internos)
META_APP_ID=REEMPLAZA_APP_ID
# App Secret (misma pantalla, botón "Mostrar"). NUNCA con prefijo NEXT_PUBLIC_.
META_APP_SECRET=REEMPLAZA_APP_SECRET
# Configuration ID del Embedded Signup (WhatsApp → Embedded Signup → Configuraciones)
NEXT_PUBLIC_META_CONFIG_ID=REEMPLAZA_CONFIG_ID
# Token de verificación del webhook. Coincide EXACTAMENTE con el de Meta Dashboard.
# Genera con: openssl rand -hex 32
WEBHOOK_VERIFY_TOKEN=REEMPLAZA_verify_token
# Graph API version (opcional, por defecto v22.0)
# META_GRAPH_VERSION=v22.0
# NEXT_PUBLIC_META_GRAPH_VERSION=v22.0
# Enforce firma HMAC-SHA256 del webhook. En producción: true (default).
# En local con curl: META_WEBHOOK_ENFORCE_SIGNATURE=false
# META_WEBHOOK_ENFORCE_SIGNATURE=false
# Prefijo telefónico por defecto para Bolivia
WABA_DEFAULT_COUNTRY_CODE=591
# Timeout de llamadas a Meta en ms (default 15000)
# WABA_REQUEST_TIMEOUT_MS=15000

# --- Almacenamiento de Objetos S3-Compatible (R2/MinIO) ---
# Cloudflare R2: panel → R2 → Manage API Tokens → Create API Token.
# El endpoint tiene la forma https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=REEMPLAZA_endpoint_r2
S3_ACCESS_KEY_ID=REEMPLAZA_access_key_id
S3_SECRET_ACCESS_KEY=REEMPLAZA_secret_access_key
S3_BUCKET_NAME=REEMPLAZA_nombre_del_bucket

# --- Agente IA / OpenRouter ---
# Cómo obtenerlo: openrouter.ai → Keys → Create Key
OPENROUTER_API_TOKEN=REEMPLAZA_openrouter_key
# Modelo principal del chatbot (ej. anthropic/claude-sonnet-4)
OPENROUTER_MODEL=REEMPLAZA_modelo
# Base URL (opcional, por defecto https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo evaluador y temperatura (opcionales)
# OPENROUTER_JUDGE_MODEL=REEMPLAZA_modelo_juez
# OPENROUTER_TEMPERATURE=0.3
# Ventana de agrupación de mensajes entrantes del agente, en ms (opcional)
# AGENT_COALESCE_MS=8000

# --- Correo Transaccional (SMTP) ---
# Host del servidor SMTP para recuperación de contraseña e invitaciones de equipo.
# NOTA: el envío real está pendiente (spec 012); hoy EmailService es un mock.
SMTP_HOST=REEMPLAZA_smtp_host

# --- Jobs Programados ---
# Secreto que autentica las llamadas a /api/cron/*. Generar: openssl rand -hex 32
# OBLIGATORIO: sin él los endpoints de cron responden 503 (spec 011, FR-018).
CRON_SECRET=REEMPLAZA_cron_secret

# --- Configuración de App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Moneda por defecto cuando la organización no define la suya. Valores: BOB | USD | CLP
BILLING_CURRENCY=BOB
