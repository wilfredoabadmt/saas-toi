# =============================================================================
#  .env.example — Copia este archivo a .env y rellena las credenciales.
# =============================================================================

# --- Base de Datos PostgreSQL ---
DATABASE_URL=postgres://user:pass@localhost:5432/saas_toi

# --- Cifrado de Secretos ---
# Clave AES-256-GCM (32 bytes hex). Generar con: openssl rand -hex 32
ENCRYPTION_KEY=REEMPLAZA_32_bytes_hex

# --- Meta WhatsApp Cloud API ---
# App ID público (developers.facebook.com → Tu app → Configuración → Básica)
# Usado por el SDK del navegador para Embedded Signup.
NEXT_PUBLIC_META_APP_ID=REEMPLAZA_APP_ID
# App ID legacy (mismo valor que NEXT_PUBLIC_META_APP_ID, para servicios internos)
META_APP_ID=REEMPLAZA_APP_ID
# App Secret (misma pantalla, botón "Mostrar"). NUNCA con prefijo NEXT_PUBLIC_.
META_APP_SECRET=REEMPLAZA_APP_SECRET
# Configuration ID del Embedded Signup (WhatsApp → Embedded Signup → Configuraciones)
NEXT_PUBLIC_META_CONFIG_ID=REEMPLAZA_CONFIG_ID
# Token de verificación del webhook. Coincide EXACTAMENTE con el de Meta Dashboard.
# Genera con: openssl rand -hex 32
WEBHOOK_VERIFY_TOKEN=REEMPLAZA_verify_token
# Graph API version (opcional, por defecto v22.0)
# META_GRAPH_VERSION=v22.0
# Enforce firma HMAC-SHA256 del webhook. En producción: true (default).
# En local con curl: META_WEBHOOK_ENFORCE_SIGNATURE=false
# META_WEBHOOK_ENFORCE_SIGNATURE=false
# Prefijo telefónico por defecto para Bolivia
WABA_DEFAULT_COUNTRY_CODE=591
# Timeout de llamadas a Meta en ms (default 15000)
# WABA_REQUEST_TIMEOUT_MS=15000

# --- Almacenamiento de Objetos S3-Compatible (R2/MinIO) ---
S3_ENDPOINT=https://d030e52371379140cc2446754418d694.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=e83ed15795b0013232b24c9ff318fc60
S3_SECRET_ACCESS_KEY=01f7a9c28b017c65c0e203d003d814e4f7d0958423de940fa4472f836b8d785c
S3_BUCKET_NAME=saas-toi-files

# --- Configuración de App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
