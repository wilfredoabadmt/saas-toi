# =============================================================================
# MÓDULO WABA — Variables de entorno para SaaS TOI
# =============================================================================
# Añade estas variables a tu .env / a Coolify. NO borres las que ya tengas.
#
# Comprueba el estado con:  npx tsx scripts/audit-waba.ts
# =============================================================================


# -----------------------------------------------------------------------------
# Meta / Facebook Developers  (OBLIGATORIAS)
# -----------------------------------------------------------------------------

# App ID. developers.facebook.com → Tu app → Configuración → Básica
# Es público: va con prefijo NEXT_PUBLIC_ porque el SDK del navegador lo usa.
NEXT_PUBLIC_META_APP_ID=

# App Secret. MISMA pantalla, botón "Mostrar".
# 🚫 SECRETO. Nunca con prefijo NEXT_PUBLIC_. Firma los webhooks y el deauthorize.
META_APP_SECRET=

# Configuration ID del Embedded Signup.
# developers.facebook.com → Tu app → WhatsApp → Embedded Signup → Configuraciones
# Sin esto el botón de conexión automática no funciona.
NEXT_PUBLIC_META_CONFIG_ID=

# Token de verificación del webhook. Cadena arbitraria que inventas tú.
# Debe coincidir EXACTAMENTE con la que pongas en Meta → WhatsApp → Configuración → Webhook.
# Genera una con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=

# Versión de la Graph API. Opcional; por defecto v22.0.
# META_GRAPH_VERSION=v22.0


# -----------------------------------------------------------------------------
# Cifrado  (OBLIGATORIA)
# -----------------------------------------------------------------------------

# Clave AES-256-GCM para cifrar el access token en waba_configs.
# DEBE tener exactamente 32 bytes. Genera una con:
#     openssl rand -base64 32
#
# ⚠️ SI PIERDES O CAMBIAS ESTA CLAVE, TODOS LOS TOKENS GUARDADOS SE VUELVEN
#    ILEGIBLES y cada cliente tendrá que reconectar su número.
#    Guárdala en tu gestor de secretos, no solo en Coolify.
WABA_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Aplicación  (RECOMENDADAS)
# -----------------------------------------------------------------------------

# URL pública. Se usa para construir la URL de confirmación de borrado de datos.
NEXT_PUBLIC_APP_URL=https://saas-toi-ssd.89.116.29.168.sslip.io

# Prefijo telefónico por defecto. Bolivia = 591.
WABA_DEFAULT_COUNTRY_CODE=591

# Timeout de las llamadas a Meta, en ms.
# WABA_REQUEST_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# Depuración  (NO USAR EN PRODUCCIÓN)
# -----------------------------------------------------------------------------

# Pon 'false' SOLO en local para probar el webhook con curl sin calcular la firma.
# En producción déjala sin definir (el valor por defecto es exigir firma).
# 🚫 Con esto en 'false', cualquiera puede inyectar eventos falsos.
# META_WEBHOOK_ENFORCE_SIGNATURE=false


# =============================================================================
# COMPROBACIÓN RÁPIDA
# =============================================================================
# node -e "const k=process.env.WABA_ENCRYPTION_KEY; \
#   console.log('bytes:', Buffer.from(k,'base64').length, '→ debe ser 32')"
#
# curl -s "$NEXT_PUBLIC_APP_URL/api/waba/webhook?hub.mode=subscribe\
# &hub.verify_token=$META_WEBHOOK_VERIFY_TOKEN&hub.challenge=ok"
# # → debe imprimir exactamente: ok
# =============================================================================
